# Copia este archivo a .env y rellena los valores. Nunca subas .env a Git.
# anthropic = extracción real con Claude · demo = sin LLM ni coste (solo facturas de eval/dataset)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
DATABASE_URL=postgresql+psycopg://facturas:facturas@localhost:5432/facturas
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_DAY=20
LOG_LEVEL=INFO
