# Copie este arquivo para .env e preencha os valores. Nunca envie o .env para o Git.
# anthropic = extração real com Claude · demo = sem LLM nem custo (só faturas de ejemplos/ e eval/dataset)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
DATABASE_URL=postgresql+psycopg://facturas:facturas@localhost:5432/facturas
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_DAY=20
LOG_LEVEL=INFO
